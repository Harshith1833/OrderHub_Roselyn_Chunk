@page
@model OrderHub.Pages.Orders.CreateModel
@{ ViewData["Title"] = "New order"; }

<h1>New order</h1>

<form method="post" class="form panel">
    <label>Customer
        <input asp-for="Order.CustomerName" />
        <span class="field-err" asp-validation-for="Order.CustomerName"></span>
    </label>
    <label>Product
        <input asp-for="Order.Product" />
        <span class="field-err" asp-validation-for="Order.Product"></span>
    </label>
    <div class="row">
        <label>Quantity
            <input asp-for="Order.Quantity" type="number" min="1" />
            <span class="field-err" asp-validation-for="Order.Quantity"></span>
        </label>
        <label>Unit price
            <input asp-for="Order.UnitPrice" type="number" step="0.01" min="0.01" />
            <span class="field-err" asp-validation-for="Order.UnitPrice"></span>
        </label>
    </div>
    <div class="form-actions">
        <button class="btn" type="submit">Create &amp; continue to payment</button>
        <a href="/Orders">Cancel</a>
    </div>
</form>
