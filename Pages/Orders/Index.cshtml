@page
@model OrderHub.Pages.Orders.IndexModel
@{ ViewData["Title"] = "Orders"; }

<div class="page-head">
    <h1>Orders</h1>
    <a class="btn" href="/Orders/Create">+ New order</a>
</div>

<div class="filters">
    <a class="@(Model.Status == null ? "active" : "")" href="/Orders">All</a>
    @foreach (var s in Enum.GetValues<OrderStatus>())
    {
        <a class="@(Model.Status == s ? "active" : "")" href="/Orders?status=@s">@s</a>
    }
</div>

<section class="panel">
<table>
    <tr><th>#</th><th>Customer</th><th>Product</th><th>Qty</th><th>Total</th><th>Status</th><th>Created</th><th></th></tr>
    @foreach (var o in Model.Orders)
    {
        <tr>
            <td>@o.Id</td>
            <td>@o.CustomerName</td>
            <td>@o.Product</td>
            <td>@o.Quantity</td>
            <td>@o.Total.ToString("C")</td>
            <td><span class="badge @o.Status.ToString().ToLower()">@o.Status</span></td>
            <td>@o.CreatedAt.ToString("dd MMM yyyy")</td>
            <td class="actions">
                @if (o.Status == OrderStatus.Pending)
                {
                    <a class="btn small" href="/Payments/Pay?orderId=@o.Id">Pay</a>
                }
                @if (o.Status != OrderStatus.Cancelled)
                {
                    <form method="post" asp-page-handler="Cancel" asp-route-id="@o.Id" style="display:inline">
                        <button class="btn small danger" type="submit">Cancel</button>
                    </form>
                }
            </td>
        </tr>
    }
    @if (!Model.Orders.Any())
    {
        <tr><td colspan="8" class="muted">No orders found.</td></tr>
    }
</table>
</section>
